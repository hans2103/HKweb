{
    "name": "hkweb",
    "version": "26.18.1",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "postbuild": "next-sitemap",
        "build:analyze": "ANALYZE=true next build",
        "start": "next start",
        "lint": "eslint --fix .",
        "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "panda codegen --silent && husky"
    },
    "engines": {
        "node": "24.x",
        "npm": ">=11"
    },
    "dependencies": {
        "eslint-config-next": "^16.2.4",
        "next": "^16.2.4",
        "react": "^19.2.5",
        "react-dom": "^19.2.5"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@next/bundle-analyzer": "^16.2.4",
        "@next/eslint-plugin-next": "^16.2.4",
        "@pandacss/dev": "^1.10.0",
        "@pandacss/eslint-plugin": "^0.3.2",
        "@pandacss/postcss": "^1.11.0",
        "@svgr/webpack": "^8.1.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^25.6.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.1",
        "@vitest/coverage-v8": "^4.1.5",
        "eslint": "^9.38.0",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.32.0",
        "lint-staged": "^16.4.0",
        "next-sitemap": "^4.2.3",
        "prettier": "^3.8.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.5"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    }
}
