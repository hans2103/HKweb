{
    "name": "hkweb",
    "version": "26.18.1",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "postbuild": "next-sitemap",
        "build:analyze": "ANALYZE=true next build",
        "start": "next start",
        "lint": "eslint --fix .",
        "format": "prettier --write './**/*.{js,jsx,ts,tsx,css,md,json}' --config ./.prettierrc",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "prepare": "panda codegen --silent && husky"
    },
    "engines": {
        "node": "24.x",
        "npm": ">=11"
    },
    "dependencies": {
        "next": "^16.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^20.5.3",
        "@next/bundle-analyzer": "^16.3.8",
        "@next/eslint-plugin-next": "^16.3.8",
        "@pandacss/dev": "^2.1.1",
        "@pandacss/eslint-plugin": "^2.1.1",
        "@pandacss/postcss": "^2.1.1",
        "@svgr/webpack": "^8.1.0",
        "@testing-library/jest-dom": "^6.10.0",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "~6.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.39.5",
        "eslint-config-next": "^16.3.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "husky": "^9.1.7",
        "jsdom": "^29.1.1",
        "lightningcss": "^1.33.0",
        "lint-staged": "^16.4.0",
        "next-sitemap": "^4.2.3",
        "prettier": "^3.9.9",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "overrides": {
        "browserslist": "^4.29.3",
        "postcss": "^8.5.28",
        "postcss-selector-parser": "^7.1.6"
    }
}
