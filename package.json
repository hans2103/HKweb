{
    "name": "hkweb",
    "version": "26.18.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "astro dev",
        "build": "astro check && astro build",
        "preview": "astro preview",
        "lint": "eslint --fix .",
        "format": "prettier --write .",
        "pretest": "astro build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "images": "node scripts/generate-images.mjs",
        "prepare": "husky"
    },
    "engines": {
        "node": "24.x",
        "npm": ">=11"
    },
    "dependencies": {
        "astro": "^7.4.2"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.12",
        "@commitlint/cli": "^21.2.4",
        "@eslint/js": "^10.0.1",
        "@types/node": "^24.19.2",
        "@vitest/coverage-v8": "^5.0.5",
        "eslint": "^10.13.0",
        "eslint-plugin-astro": "^3.2.1",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "globals": "^17.13.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prettier": "^3.9.10",
        "prettier-plugin-astro": "^1.1.2",
        "sharp": "^0.35.5",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vitest": "^5.0.5"
    },
    "lint-staged": {
        "*.{js,mjs,ts,astro}": [
            "eslint --fix"
        ]
    }
}
