---
import Logo from '../assets/logo-hkweb.svg';
import { pagePath } from '../lib/url';

// Section links point at the homepage; on the homepage itself they stay in-page.
const home = pagePath(Astro.url) === '/' ? '' : '/';
const links = [
    { href: `${home}#werk`, label: 'Werk' },
    { href: `${home}#vragen`, label: 'Vragen' },
    { href: `${home}#diensten`, label: 'Diensten' },
    { href: `${home}#kennis`, label: 'Over Hans' },
    { href: `${home}#contact`, label: 'Contact' }
];
---

<header class="site-header container">
    <a class="site-logo" href="/">
        <Logo aria-hidden="true" />
        <span>HKweb</span>
    </a>
    <nav class="site-nav" aria-label="Hoofdmenu">
        <ul>
            {links.map(({ href, label }) => (
                <li>
                    <a href={href}>{label}</a>
                </li>
            ))}
        </ul>
    </nav>
</header>
