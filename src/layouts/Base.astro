---
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';

import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { OG_IMAGE, PERSON_NAME, SITE_DESCRIPTION, SITE_NAME, SITE_URL } from '../data/site';
import { pagePath } from '../lib/url';

interface Props {
    /** Full document title (keep under ~60 characters). */
    title?: string;
    description?: string;
    noindex?: boolean;
    /** Open Graph type; `profile` adds the person's name (homepage). */
    ogType?: 'website' | 'profile' | 'article';
    /** schema.org data, rendered as a JSON-LD block (a data block, not script). */
    jsonLd?: Record<string, unknown>;
}

const {
    title = `${PERSON_NAME}: frontend developer voor Joomla en Magento | ${SITE_NAME}`,
    description = SITE_DESCRIPTION,
    noindex = false,
    ogType = 'website',
    jsonLd
} = Astro.props;

const pageUrl = SITE_URL + pagePath(Astro.url);
---

<!doctype html>
<html lang="nl">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        {noindex ? (
            <meta name="robots" content="noindex" />
        ) : (
            <link rel="canonical" href={pageUrl} />
        )}
        <meta name="color-scheme" content="light dark" />
        <meta name="theme-color" content="#dce3df" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#161c21" media="(prefers-color-scheme: dark)" />
        <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
        <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16x16.png" />
        <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
        <link rel="manifest" href="/favicon/site.webmanifest" />

        <meta property="og:type" content={ogType} />
        {ogType === 'profile' && (
            <>
                <meta property="profile:first_name" content="Hans" />
                <meta property="profile:last_name" content="Kuijpers" />
            </>
        )}
        <meta property="og:locale" content="nl_NL" />
        <meta property="og:site_name" content={SITE_NAME} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={OG_IMAGE.url} />
        <meta property="og:image:width" content={String(OG_IMAGE.width)} />
        <meta property="og:image:height" content={String(OG_IMAGE.height)} />
        <meta property="og:image:alt" content={OG_IMAGE.alt} />
        <meta name="twitter:card" content="summary_large_image" />

        <link
            rel="alternate"
            type="text/plain"
            href="/llms.txt"
            title="Samenvatting voor AI-assistenten"
        />
        <link rel="sitemap" href="/sitemap.xml" />
        {jsonLd && (
            <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
        )}
    </head>
    <body>
        <a class="skip-link" href="#main">
            Naar hoofdinhoud
        </a>
        <Header />
        <main id="main" tabindex="-1">
            <slot />
        </main>
        <Footer />
    </body>
</html>
