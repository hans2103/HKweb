---
import { getCollection, render } from 'astro:content';

import Picture from '../../components/Picture.astro';
import { PERSON_NAME, SITE_EMAIL, SITE_NAME, SITE_URL } from '../../data/site';
import Base from '../../layouts/Base.astro';
import { WERK_WIDTHS, werkImage } from '../../lib/images';

export async function getStaticPaths() {
    const werk = (await getCollection('werk')).sort((a, b) => a.data.order - b.data.order);
    const cases = werk.filter((entry) => entry.data.case);
    // "Next case" wraps around to the first one.
    return cases.map((entry, index) => ({
        params: { id: entry.id },
        props: { entry, next: cases.length > 1 ? cases[(index + 1) % cases.length] : undefined }
    }));
}

const { entry, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const pageUrl = `${SITE_URL}/werk/${entry.id}`;
const description = `${data.title}: ${data.intro ?? data.summary}`;

const jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': pageUrl,
    url: pageUrl,
    name: `${data.title} | ${SITE_NAME}`,
    inLanguage: 'nl-NL',
    breadcrumb: {
        '@type': 'BreadcrumbList',
        itemListElement: [
            { '@type': 'ListItem', position: 1, name: 'Werk', item: `${SITE_URL}/#werk` },
            { '@type': 'ListItem', position: 2, name: data.title, item: pageUrl }
        ]
    },
    about: {
        '@type': 'WebSite',
        name: data.title,
        url: data.url,
        creator: { '@id': `${SITE_URL}/#person`, name: PERSON_NAME },
        ...(data.since && { dateCreated: String(data.since) })
    }
};
---

<Base
    title={`${data.title}: case | ${SITE_NAME}`}
    description={description}
    ogType="article"
    jsonLd={jsonLd}>
    <article>
        <header class="case-header container">
            <nav class="breadcrumb" aria-label="Kruimelpad">
                <ol>
                    <li>
                        <a href="/#werk">Werk</a>
                    </li>
                    <li>
                        <a href={`/werk/${entry.id}`} aria-current="page">
                            {data.title}
                        </a>
                    </li>
                </ol>
            </nav>
            <h1>{data.title}</h1>
            <p class="muted">{data.intro ?? data.summary}</p>
            <dl class="case-meta">
                <div>
                    <dt>Opdrachtgever</dt>
                    <dd>{data.client}</dd>
                </div>
                {data.role && (
                    <div>
                        <dt>Rol</dt>
                        <dd>{data.role}</dd>
                    </div>
                )}
                <div>
                    <dt>Techniek</dt>
                    <dd>{data.tech.join(', ')}</dd>
                </div>
                {data.since && (
                    <div>
                        <dt>Sinds</dt>
                        <dd>{data.since}</dd>
                    </div>
                )}
                <div>
                    <dt>Vorm</dt>
                    <dd>{data.relation}</dd>
                </div>
                <div>
                    <dt>Website</dt>
                    <dd>
                        <a href={data.url}>{new URL(data.url).hostname}</a>
                    </dd>
                </div>
            </dl>
        </header>

        <div class="container">
            <Picture
                src={werkImage(data.image)}
                widths={WERK_WIDTHS}
                sizes="(min-width: 77.5rem) 72rem, 100vw"
                alt={`Homepage van ${data.title}`}
                width={960}
                height={600}
                loading="eager"
                fetchpriority="high"
                class="case-image"
            />
        </div>

        <div class="section container">
            <div class="prose flow">
                <Content />
            </div>
        </div>
    </article>

    {next && (
        <section class="section section--inverse" aria-labelledby="volgende-titel">
            <div class="container flow">
                <p class="eyebrow">Volgende case</p>
                <h2 id="volgende-titel">
                    <a href={`/werk/${next.id}`}>{next.data.title}</a>
                </h2>
            </div>
        </section>
    )}

    <section class="section section--surface" aria-labelledby="contact-titel">
        <div class="container contact">
            <h2 id="contact-titel">Ook zo’n site die jaren meegaat?</h2>
            <a class="button button--cta" href={`mailto:${SITE_EMAIL}`}>
                {SITE_EMAIL}
            </a>
        </div>
    </section>
</Base>
